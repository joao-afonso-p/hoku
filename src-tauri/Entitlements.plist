<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements, applied only when Hoku is code signed (release builds).
  Hoku sends Apple Events (through /usr/bin/osascript) to switch to or open Claude Code
  sessions in iTerm and Terminal. The hardened runtime blocks that unless this entitlement
  is present; macOS still asks the user for Automation permission once per app.
  Hoku is not sandboxed, so no other entitlements are needed.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
