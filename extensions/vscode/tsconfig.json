{
  // Type-checks the extension and its tests (`pnpm typecheck`). The VSIX build
  // (`pnpm vscode:build`) uses tsconfig.build.json, which leaves the tests out of `out/`.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // package.json has no "type": "module", so node16 emits CommonJS.
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node", "vscode"],
    "rootDir": "src",
    "outDir": "out",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
